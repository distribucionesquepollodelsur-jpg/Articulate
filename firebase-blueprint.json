{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private profile data for a user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email"]
    },
    "UserProgress": {
      "title": "User Progress",
      "description": "Tracks a user's progress through lessons and IPA mastery.",
      "type": "object",
      "properties": {
        "xp": { "type": "integer" },
        "level": { "type": "integer" },
        "streak": { "type": "integer" },
        "lastActivityAt": { "type": "string", "format": "date-time" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "masteredIPAs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["xp", "level", "streak"]
    },
    "ActivityLog": {
      "title": "Activity Log",
      "description": "A record of a single educational activity.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["lesson", "game", "lab", "studio"] },
        "activityId": { "type": "string" },
        "xpGained": { "type": "integer" },
        "score": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "activityId", "xpGained", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Core profile data."
    },
    "/users/{userId}/progress/data": {
      "schema": "UserProgress",
      "description": "Detailed progress for a user."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityLog",
      "description": "Log of user activities."
    },
    "/leaderboard/global/entries/{userId}": {
      "schema": "UserProgress",
      "description": "Publicly visible progress for leaderboard rankings."
    }
  }
}
